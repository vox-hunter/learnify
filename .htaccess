# Apache .htaccess configuration for Streamlit SPA routing
# This ensures direct URL access to routes serves the main Streamlit app
# Place this file in your web root directory

RewriteEngine On

# Handle privacy, terms, course, and login routes
RewriteRule ^(privacy|terms|course|login)/?$ / [L,QSA]

# For other SPA routes, you may want to add more specific rules
# RewriteRule ^your-other-route/?$ / [L,QSA]

# Optional: Force HTTPS (uncomment if needed)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]