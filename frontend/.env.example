# Environment variables template
# Copy this file to .env.local and fill in your values

# API Configuration
VITE_API_BASE_URL=

# App Configuration
VITE_APP_TITLE=AI Loom
VITE_APP_DESCRIPTION=Transform documents into interactive learning experiences

# Feature Flags
VITE_ENABLE_ANALYTICS=false

# Debug Settings
VITE_LOG_LEVEL=info